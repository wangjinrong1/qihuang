# 大模型运行模式：
#   auto  = 有适配器路径 → local；否则有 LLM_API_KEY → api；都没有 → mock
#   local = 本地小模型（基座+适配器）   api = 云端 API   mock = 演示
LLM_MODE=auto
# 基座模型（HuggingFace 名称或本地目录）
LLM_BASE_MODEL=Qwen/Qwen1.5-1.8B-Chat
# 中医微调适配器（LoRA）的本地目录或 HuggingFace 名称；留空则走演示模式
LLM_ADAPTER_PATH=
# 运行 scripts/download_model.py 后，可直接写：
#   LLM_BASE_MODEL=models/base
#   LLM_ADAPTER_PATH=models/adapter
# 单次回答最长生成多少 token（CPU 上建议 300~400，否则很慢）
LLM_MAX_NEW_TOKENS=768
LLM_TEMPERATURE=0.7
# 推理设备：auto（有显卡用显卡）| cpu | cuda
LLM_DEVICE=auto
# 启动服务时是否后台预加载模型（1=是）
LLM_PRELOAD=1
# 本地小模型防重复（1.1~1.3，越大越不爱重复，过大会胡言乱语）
LLM_REPETITION_PENALTY=1.15

# ---- 云端 API 模式（OpenAI 兼容接口，默认 DeepSeek）----
# 用法：LLM_MODE=api，并填写下面的 LLM_API_KEY。想用本地模型就把 LLM_MODE 改回 local。
# 提示：问诊内容会发送到第三方服务器，请勿填真实姓名等隐私信息；.env 不要上传或分享。
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
# 模型名以服务商文档为准（DeepSeek 常用 deepseek-chat）
LLM_API_MODEL=deepseek-chat
LLM_API_TIMEOUT=120

# 舌象分类权重（ResNet18，可选）；留空则走演示模式。训练见 README“训练舌苔分类权重”，产物默认 models/tongue_resnet18.pth
TONGUE_WEIGHTS=

# 中药图片识别（可选）：权重文件 + 类别名文件（每行一个药名，顺序与训练一致）
HERB_WEIGHTS=
HERB_LABELS=
HERB_ARCH=resnet50

HOST=127.0.0.1
PORT=8000

# ---- 联网检索（界面“联网检索”开关打开时使用）----
# auto：依次尝试 Serper → Bing中国版 → DuckDuckGo；填了 SERPER_API_KEY 最稳定（serper.dev，有免费额度）
WEB_SEARCH_PROVIDER=auto
SERPER_API_KEY=
WEB_SEARCH_TIMEOUT=6
